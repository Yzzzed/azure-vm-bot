# Azure VM Bot 配置文件
# 复制这个文件为 .env.azure 并填写你的真实信息

# 机器人基本配置
AZURE_BOT_NAME=AzureVmBot
AZURE_BOT_COMMAND_PREFIX=/
# 允许控制服务器的用户ID列表（逗号分隔）
# 注意：这是聊天平台的用户ID，不是Azure账号ID
AZURE_BOT_ALLOWED_USERS=your_user_id_here

# Azure VM 配置
# 设置为 true 启用真实的 Azure API 调用
AZURE_VM_ENABLED=false

# Azure 认证信息（从 Azure 门户获取）
# 1. 租户ID: Azure 门户 -> Microsoft Entra ID -> 概览 -> 租户 ID
AZURE_VM_TENANT_ID=your-tenant-id-here

# 2. 应用程序(客户端)ID: Azure 门户 -> Microsoft Entra ID -> 应用注册 -> 你的应用 -> 应用程序(客户端) ID
AZURE_VM_CLIENT_ID=your-client-id-here

# 3. 客户端密码: Azure 门户 -> 应用注册 -> 证书和密码 -> 客户端密码的 Value（不是 Secret ID）
AZURE_VM_CLIENT_SECRET=your-client-secret-here

# 4. 订阅ID: Azure 门户 -> 订阅 -> 目标订阅 -> 概览 -> 订阅 ID
AZURE_VM_SUBSCRIPTION_ID=your-subscription-id-here

# 5. 资源组: Azure 门户 -> 虚拟机 -> 你的 VM -> 概览 -> 资源组
AZURE_VM_RESOURCE_GROUP=your-resource-group-name

# 6. VM名称: Azure 门户 -> 虚拟机 -> 你的 VM -> 概览 -> 资源名称（不是公网IP）
AZURE_VM_NAME=your-vm-name

# Azure API 版本（一般不需要修改）
AZURE_VM_API_VERSION=2023-09-01
